# ==============================================================================
# AI-DBC Complete Environment Configuration
# Copy to .env and fill in your secrets
# ==============================================================================

# Application
APP_NAME="AI-DBC"
DEBUG=false
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000
TRUST_PROXY_HEADERS=true
BACKEND_BIND_HOST=127.0.0.1
FRONTEND_BIND_HOST=127.0.0.1
HEALTHCHECK_HOST=ai-dbc.zeaz.dev

# OpenWebUI Core
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:latest
OPENWEBUI_URL=https://ai-dbc.zeaz.dev
# Generate with: openssl rand -hex 32
OPENWEBUI_SECRET_KEY=
OPENWEBUI_CORS_ALLOW_ORIGIN=https://ai-dbc.zeaz.dev
OPENWEBUI_BIND_HOST=127.0.0.1
OPENWEBUI_HOST_PORT=3001

# Model (CPU-only defaults)
MODEL_NAME="Qwen/Qwen2.5-1.5B-Instruct-GGUF"
MODEL_FILE="qwen2.5-1.5b-instruct-q4_k_m.gguf"
# Pin immutable 40-character Hugging Face commits in production.
MODEL_REVISION=
# Pin the exact downloaded GGUF bytes in production.
MODEL_SHA256=
MODEL_PATH=/app/models
MAX_CONTEXT_LENGTH=4096
N_THREADS=4
N_BATCH=512

# Free-model routing. Keep remote providers disabled unless access is explicitly configured.
MODEL_MODE=auto_free
FREE_PROVIDER_ORDER=kilo,opencode,openrouter,local
REMOTE_MODELS_ENABLED=false
# Generate with: openssl rand -hex 32
QWENDBC_ACCESS_TOKEN=
REMOTE_REQUEST_TIMEOUT_SECONDS=60
REMOTE_MAX_CONCURRENT_REQUESTS=4
REMOTE_RATE_LIMIT_PER_MINUTE=30

# Optional hosted provider credentials. Do not commit real keys.
KILO_BASE_URL=https://api.kilo.ai/api/gateway
KILO_API_KEY=
KILO_MODEL=kilo-auto/free
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_API_KEY=
OPENCODE_FREE_MODEL=auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Generation
TEMPERATURE=0.7
TOP_P=0.9
MAX_TOKENS=2048

# Local document retrieval / RAG
CHROMA_DB_PATH=./chroma_db
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_MODEL_REVISION=
RAG_COLLECTION="documents"
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_EMBED_BATCH_SIZE=32
MAX_RAG_CHUNKS=100000
MAX_UPLOAD_BYTES=5000000

# CORS
ALLOWED_ORIGINS="https://ai-dbc.zeaz.dev"
ALLOWED_HOSTS="ai-dbc.zeaz.dev,localhost,127.0.0.1,testserver"

# Request bounds
MAX_CHAT_CONTENT_BYTES=1000000

# ==============================================================================
# OPENWEBUI ENTERPRISE FEATURES
# ==============================================================================

# Authentication & SSO
OPENWEBUI_ENABLE_LDAP=false
OPENWEBUI_LDAP_SERVER_URI=
OPENWEBUI_LDAP_BIND_DN=
OPENWEBUI_LDAP_BIND_PASSWORD=
OPENWEBUI_LDAP_USER_SEARCH_BASE=
OPENWEBUI_LDAP_USER_SEARCH_FILTER=(uid=%s)
OPENWEBUI_LDAP_GROUP_SEARCH_BASE=
OPENWEBUI_LDAP_GROUP_SEARCH_FILTER=(member=%s)

# OAuth / OIDC Providers (JSON array)
OPENWEBUI_OAUTH_PROVIDERS=
OPENWEBUI_OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true

# RBAC & Admin
OPENWEBUI_DEFAULT_USER_ROLE=user
OPENWEBUI_DEFAULT_MODELS=
ENABLE_ADMIN_EXPORT=true
ENABLE_ADMIN_CHAT_ACCESS=true

# RAG Configuration
ENABLE_RAG=true
OPENWEBUI_RAG_EMBEDDING_ENGINE=ollama
OPENWEBUI_RAG_EMBEDDING_MODEL=nomic-embed-text
OPENWEBUI_RAG_CHUNK_SIZE=1000
OPENWEBUI_RAG_CHUNK_OVERLAP=200
OPENWEBUI_RAG_TOP_K=5
OPENWEBUI_RAG_TEMPLATE=

# Web Search
OPENWEBUI_ENABLE_WEB_SEARCH=true
OPENWEBUI_WEB_SEARCH_ENGINE=searxng
OPENWEBUI_SEARXNG_BASE_URL=
OPENWEBUI_GOOGLE_PSE_API_KEY=
OPENWEBUI_GOOGLE_PSE_CX=
OPENWEBUI_BRAVE_SEARCH_API_KEY=

# Functions & Tools
ENABLE_FUNCTIONS=true
OPENWEBUI_FUNCTIONS_MODULE=

# Model Routing
ENABLE_MODEL_FILTER=true
OPENWEBUI_MODEL_ORDER_LIST=

# Branding
OPENWEBUI_WEBUI_NAME=AI-DBC
OPENWEBUI_WEBUI_FAVICON_URL=
OPENWEBUI_DEFAULT_LOCALE=en-US
OPENWEBUI_DEFAULT_THEME=system

# Audit & Compliance
OPENWEBUI_ENABLE_AUDIT_LOG=true
OPENWEBUI_AUDIT_LOG_LEVEL=info

# Advanced Features
OPENWEBUI_ENABLE_EVALUATION_ARENA=false
OPENWEBUI_ENABLE_COMMUNITY_SHARING=false
OPENWEBUI_ENABLE_MESSAGE_RATING=true
OPENWEBUI_ENABLE_CODE_EXECUTION=false
OPENWEBUI_CODE_EXECUTION_ENGINE=jupyter
OPENWEBUI_JUPYTER_URL=
OPENWEBUI_JUPYTER_TOKEN=

# File Upload & Images
OPENWEBUI_ENABLE_FILE_UPLOAD=true
OPENWEBUI_MAX_FILE_SIZE=50MB
OPENWEBUI_ENABLE_IMAGE_GENERATION=false
OPENWEBUI_IMAGE_GENERATION_ENGINE=auto
OPENWEBUI_IMAGE_GENERATION_MODEL=

# Performance & Caching
OPENWEBUI_REDIS_URL=
OPENWEBUI_CELERY_BROKER_URL=
OPENWEBUI_CELERY_RESULT_BACKEND=

# Security
OPENWEBUI_ENABLE_RATE_LIMIT=true
OPENWEBUI_RATE_LIMIT_REQUESTS=100
OPENWEBUI_RATE_LIMIT_WINDOW=60